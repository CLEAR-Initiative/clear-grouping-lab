# Copy to .env and fill from clear-pipeline's env. Never commit .env.
# Dev GraphQL endpoint (read-only use in this lab). CLEAR_API_BASE is accepted as an alias.
CLEAR_API_URL=https://dev-api.clearinitiative.io/graphql
CLEAR_API_KEY=
# OpenRouter key for Jev (Decisions API), same as clear-pipeline.
OPENROUTER_API_KEY=
# Optional overrides (defaults match clear-pipeline/providers/jev.py)
# JEV_MODEL=typesafe/jev-1.13
# JEV_URL=https://openrouter.ai/api/alpha/decisions
