{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lab-viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765"],
      "port": 8765
    },
    {
      "name": "lab-viewer-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server \"${PORT:-8767}\""],
      "port": 8767,
      "autoPort": true
    }
  ]
}
