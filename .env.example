# Copy to .env and fill from clear-pipeline's env. Never commit .env.
# Dev GraphQL endpoint (read-only use in this lab). CLEAR_API_BASE is accepted as an alias.
CLEAR_API_URL=https://dev-api.clearinitiative.io/graphql
CLEAR_API_KEY=
# Jev: ONE of these. OpenRouter (sk-or-… key, Decisions API, what clear-pipeline
# uses) or TypeSafe's own API (key from typesafe.ai; replay.py prefers this when set).
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Optional overrides. Defaults: OpenRouter → typesafe/jev-1.13 at
# https://openrouter.ai/api/alpha/decisions; TypeSafe → jev-latest at https://api.typesafe.ai/v1/systemone
# JEV_MODEL=
# JEV_URL=
